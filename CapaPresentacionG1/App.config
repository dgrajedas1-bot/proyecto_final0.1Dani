<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <connectionStrings>
    <!-- Cambie "Data Source" si su instancia de SQL Server no se llama .\SQLEXPRESS (ej. (localdb)\MSSQLLocalDB o NOMBRE-PC\SQLEXPRESS) -->
    <add name="ControlAsistenciaDBG1"
         connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=ControlAsistenciaDB;Integrated Security=True"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>
